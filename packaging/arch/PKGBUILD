# Maintainer: tnxg <tnxg@tnxg.arch>
# Personal pacman repository build. Published binaries are hosted at
# https://github.com/TNXGLab/arch-repo (GitHub Pages) and consumed through
# a [noctalia] section in pacman.conf. The upstream source repository is
# private; builds rely on the local machine's stored GitHub credentials.

pkgname=noctalia
pkgver=5.0.0
pkgrel=1
pkgdesc='A sleek, customizable desktop shell crafted for Wayland.'
arch=('x86_64')
url='https://github.com/TNXGLab/noctalia'
license=('MIT')
depends=(
  bash cairo curl fontconfig freetype2 git glib2 glibc harfbuzz
  hicolor-icon-theme jemalloc libgcc libglvnd libical libjxl libpipewire
  libqalculate librsvg libsecret libsndfile libsodium libstdc++ libwebp
  libwireplumber libxkbcommon libxml2 md4c pam polkit pango sdbus-cpp
  tomlplusplus wayland
)
options=('!debug')
source=("$pkgname::git+https://github.com/TNXGLab/noctalia.git#branch=main")
sha256sums=('SKIP')

# Rolling version: <meson version>.r<commit count>.<short hash>, so every
# pushed commit yields a strictly increasing pacman version.
pkgver() {
  cd "$srcdir/$pkgname"
  local base
  base=$(grep -m1 -E "version:\s*'[0-9]+\.[0-9]+\.[0-9]+'" meson.build | grep -oE '[0-9]+\.[0-9]+\.[0-9]+')
  printf '%s.r%s.%s' "$base" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  local _mode=release
  meson setup "build-$_mode" "$srcdir/$pkgname" --prefix=/usr --buildtype="$_mode"
  meson compile -C "build-$_mode"
}

package() {
  local _mode=release
  meson install -C "build-$_mode" --destdir "$pkgdir"

  # Shell completions must be generated from the built binary (see PACKAGING.md);
  # this is deliberately not part of the Meson install rule.
  install -dm755 \
    "$pkgdir/usr/share/bash-completion/completions" \
    "$pkgdir/usr/share/zsh/site-functions" \
    "$pkgdir/usr/share/fish/vendor_completions.d"
  "./build-$_mode/$pkgname" completions bash > "$pkgdir/usr/share/bash-completion/completions/$pkgname"
  "./build-$_mode/$pkgname" completions zsh > "$pkgdir/usr/share/zsh/site-functions/_$pkgname"
  "./build-$_mode/$pkgname" completions fish > "$pkgdir/usr/share/fish/vendor_completions.d/$pkgname.fish"

  install -Dm644 "$srcdir/$pkgname/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
